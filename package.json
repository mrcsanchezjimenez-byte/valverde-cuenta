{
  "name": "valverde-cuenta",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:gestion": "vite --config vite.gestion.config.ts",
    "dev:servidor": "node --disable-warning=ExperimentalWarning --watch servidor/principal.ts",
    "servidor": "node --disable-warning=ExperimentalWarning servidor/principal.ts",
    "admin": "node --disable-warning=ExperimentalWarning servidor/admin.ts",
    "sembrar": "node --disable-warning=ExperimentalWarning servidor/sembrar.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"servidor/pruebas/*.test.ts\"",
    "build": "tsc -b && vite build && vite build --config vite.gestion.config.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.23",
    "leaflet": "^1.9.4",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
